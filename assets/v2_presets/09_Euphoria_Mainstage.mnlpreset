<?xml version="1.0" encoding="UTF-8"?>
<MonolithPreset version="2" name="Euphoria Mainstage" author="Monolith Audio" category="Festival, DJ &amp; Club Anthems" tags="edm,festival,anthem,chords,bright,pad,euphoric,big room,flagship,monolith ii" description="Euphoric mainstage vocal chords: bright, wide and mix-cutting, with a lift macro for the build." favorite="0">
  <MacroLabels m1="LIFT" m2="LOWPASS" m3="WIDTH" m4="DROP"/>
  <Params>
    <Param id="phoneme_x" value="0.54"/>
    <Param id="phoneme_y" value="0.82"/>
    <Param id="orbit_enable" value="0"/>
    <Param id="orbit_rate" value="0.18"/>
    <Param id="orbit_depth" value="0.35"/>
    <Param id="orbit_sync" value="0"/>
    <Param id="register_mode" value="4"/>
    <Param id="ensemble_size" value="18"/>
    <Param id="ensemble_spread" value="0.58"/>
    <Param id="vibrato_depth" value="0.22"/>
    <Param id="attack_time" value="0.06"/>
    <Param id="release_time" value="0.9"/>
    <Param id="onset_mode" value="0"/>
    <Param id="onset_amount" value="0.3"/>
    <Param id="glottal_tension" value="0.74"/>
    <Param id="breath_amount" value="0.14"/>
    <Param id="throat_shift" value="0.5"/>
    <Param id="formant_focus" value="0.7"/>
    <Param id="sub_abyss" value="0.18"/>
    <Param id="spectral_crown" value="0.6"/>
    <Param id="master_gain" value="-2.5"/>
    <Param id="drive_amount" value="0.3"/>
    <Param id="tape_instability" value="0.04"/>
    <Param id="oxide_damping" value="0.04"/>
    <Param id="screw_pitch" value="0"/>
    <Param id="screw_depth" value="0"/>
    <Param id="oversample_hq" value="0"/>
    <Param id="space_type" value="0"/>
    <Param id="space_mix" value="0.3"/>
    <Param id="space_decay" value="0.56"/>
    <Param id="space_damp" value="0.26"/>
    <Param id="space_shimmer" value="0.3"/>
    <Param id="space_freeze" value="0"/>
    <Param id="cc64_freeze" value="0"/>
    <Param id="macro_colossus" value="0"/>
    <Param id="macro_specter" value="0"/>
    <Param id="macro_rot" value="0"/>
    <Param id="macro_abyss" value="0"/>
    <Param id="legato_enable" value="0"/>
    <Param id="glide_time" value="0.14"/>
    <Param id="expression_level" value="0.84"/>
    <Param id="v2_tex_mix" value="0"/>
    <Param id="v2_tex_asset" value="0"/>
    <Param id="v2_tex_tune" value="0"/>
    <Param id="v2_tex_keytrack" value="1"/>
    <Param id="v2_tex_attack" value="0.012"/>
    <Param id="v2_tex_release" value="0.9"/>
    <Param id="v2_tex_vel_sens" value="0.6"/>
    <Param id="v2_tex_hp" value="20"/>
    <Param id="v2_tex_lp" value="20000"/>
    <Param id="v2_tex_width" value="1"/>
    <Param id="v2_xy_x" value="0.5"/>
    <Param id="v2_xy_y" value="0.5"/>
    <Param id="v2_xy_mode" value="0"/>
    <Param id="v2_expr_vibrato" value="0.35"/>
    <Param id="v2_expr_effort" value="0.55"/>
    <Param id="v2_expr_openness" value="0.5"/>
    <Param id="v2_expr_swell" value="0.4"/>
  </Params>
  <V2Control>
    <Source id="macro1" label="LIFT" legacy="0">
      <Route dest="spectral_crown" depth="0.25" bipolar="0"/>
      <Route dest="phoneme_y" depth="0.1" bipolar="0"/>
      <Route dest="space_shimmer" depth="0.3" bipolar="0"/>
      <Route dest="space_mix" depth="0.1" bipolar="0"/>
      <Route dest="ensemble_spread" depth="0.1" bipolar="0"/>
      <Route dest="master_gain" depth="-0.04" bipolar="0"/>
    </Source>
    <Source id="macro2" label="LOWPASS" legacy="0">
      <Route dest="spectral_crown" depth="-0.45" bipolar="0"/>
      <Route dest="formant_focus" depth="-0.2" bipolar="0"/>
      <Route dest="phoneme_y" depth="-0.3" bipolar="0"/>
      <Route dest="throat_shift" depth="-0.1" bipolar="0"/>
      <Route dest="glottal_tension" depth="-0.2" bipolar="0"/>
      <Route dest="master_gain" depth="-0.05" bipolar="0"/>
    </Source>
    <Source id="macro3" label="WIDTH" legacy="0">
      <Route dest="ensemble_spread" depth="0.25" bipolar="0"/>
      <Route dest="ensemble_size" depth="0.2" bipolar="0"/>
      <Route dest="tape_instability" depth="0.06" bipolar="0"/>
    </Source>
    <Source id="macro4" label="DROP" legacy="0">
      <Route dest="sub_abyss" depth="0.35" bipolar="0"/>
      <Route dest="drive_amount" depth="0.25" bipolar="0"/>
      <Route dest="glottal_tension" depth="0.12" bipolar="0"/>
      <Route dest="master_gain" depth="-0.06" bipolar="0"/>
    </Source>
    <Source id="xy_x"/>
    <Source id="xy_y"/>
    <Source id="mod_wheel">
      <Route dest="spectral_crown" depth="0.18" bipolar="0"/>
      <Route dest="vibrato_depth" depth="0.12" bipolar="0"/>
      <Route dest="space_shimmer" depth="0.12" bipolar="0"/>
    </Source>
    <Source id="pressure">
      <Route dest="glottal_tension" depth="0.12" bipolar="0"/>
      <Route dest="spectral_crown" depth="0.12" bipolar="0"/>
      <Route dest="drive_amount" depth="0.1" bipolar="0"/>
    </Source>
    <Source id="breath">
      <Route dest="glottal_tension" depth="0.12" bipolar="0"/>
      <Route dest="spectral_crown" depth="0.12" bipolar="0"/>
      <Route dest="drive_amount" depth="0.1" bipolar="0"/>
    </Source>
  </V2Control>
</MonolithPreset>
