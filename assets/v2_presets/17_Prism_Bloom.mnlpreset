<?xml version="1.0" encoding="UTF-8"?>
<MonolithPreset version="2" name="Prism Bloom" author="Monolith Audio" category="Ethereal Hybrids &amp; Evolving Textures" tags="texture,hybrid,halo,shimmer,evolving,ambient,xy,soprano,flagship,monolith ii" description="Soprano swarm fused with a sampled halo; push the XY pad right for texture, up for light." favorite="0">
  <MacroLabels m1="BLOOM" m2="DRIFT" m3="HALO" m4="SHADOW"/>
  <Params>
    <Param id="phoneme_x" value="0.76"/>
    <Param id="phoneme_y" value="0.62"/>
    <Param id="orbit_enable" value="1"/>
    <Param id="orbit_rate" value="0.12"/>
    <Param id="orbit_depth" value="0.3"/>
    <Param id="orbit_sync" value="0"/>
    <Param id="register_mode" value="3"/>
    <Param id="ensemble_size" value="14"/>
    <Param id="ensemble_spread" value="0.6"/>
    <Param id="vibrato_depth" value="0.36"/>
    <Param id="attack_time" value="0.9"/>
    <Param id="release_time" value="3.4"/>
    <Param id="onset_mode" value="0"/>
    <Param id="onset_amount" value="0.18"/>
    <Param id="glottal_tension" value="0.52"/>
    <Param id="breath_amount" value="0.26"/>
    <Param id="throat_shift" value="2"/>
    <Param id="formant_focus" value="0.7"/>
    <Param id="sub_abyss" value="0.12"/>
    <Param id="spectral_crown" value="0.66"/>
    <Param id="master_gain" value="-4"/>
    <Param id="drive_amount" value="0.08"/>
    <Param id="tape_instability" value="0.1"/>
    <Param id="oxide_damping" value="0.04"/>
    <Param id="screw_pitch" value="0"/>
    <Param id="screw_depth" value="0"/>
    <Param id="oversample_hq" value="0"/>
    <Param id="space_type" value="0"/>
    <Param id="space_mix" value="0.44"/>
    <Param id="space_decay" value="0.84"/>
    <Param id="space_damp" value="0.2"/>
    <Param id="space_shimmer" value="0.62"/>
    <Param id="space_freeze" value="0"/>
    <Param id="cc64_freeze" value="0"/>
    <Param id="macro_colossus" value="0"/>
    <Param id="macro_specter" value="0"/>
    <Param id="macro_rot" value="0"/>
    <Param id="macro_abyss" value="0"/>
    <Param id="legato_enable" value="0"/>
    <Param id="glide_time" value="0.14"/>
    <Param id="expression_level" value="0.8"/>
    <Param id="v2_tex_mix" value="0.26"/>
    <Param id="v2_tex_asset" value="5"/>
    <Param id="v2_tex_tune" value="0"/>
    <Param id="v2_tex_keytrack" value="1"/>
    <Param id="v2_tex_attack" value="0.8"/>
    <Param id="v2_tex_release" value="3.5"/>
    <Param id="v2_tex_vel_sens" value="0.4"/>
    <Param id="v2_tex_hp" value="400"/>
    <Param id="v2_tex_lp" value="14000"/>
    <Param id="v2_tex_width" value="1.3"/>
    <Param id="v2_xy_x" value="0.5"/>
    <Param id="v2_xy_y" value="0.5"/>
    <Param id="v2_xy_mode" value="2"/>
    <Param id="v2_expr_vibrato" value="0.45"/>
    <Param id="v2_expr_effort" value="0.45"/>
    <Param id="v2_expr_openness" value="0.6"/>
    <Param id="v2_expr_swell" value="0.5"/>
  </Params>
  <V2Control>
    <Source id="macro1" label="BLOOM" legacy="0">
      <Route dest="v2_tex_mix" depth="0.5" bipolar="0"/>
      <Route dest="space_shimmer" depth="0.35" bipolar="0"/>
      <Route dest="spectral_crown" depth="0.25" bipolar="0"/>
      <Route dest="master_gain" depth="-0.05" bipolar="0"/>
    </Source>
    <Source id="macro2" label="DRIFT" legacy="0">
      <Route dest="orbit_depth" depth="0.4" bipolar="0"/>
      <Route dest="tape_instability" depth="0.25" bipolar="0"/>
    </Source>
    <Source id="macro3" label="HALO" legacy="0">
      <Route dest="v2_tex_width" depth="0.6" bipolar="0"/>
      <Route dest="v2_tex_hp" depth="0.4" bipolar="0"/>
      <Route dest="space_mix" depth="0.25" bipolar="0"/>
      <Route dest="space_shimmer" depth="0.2" bipolar="0"/>
    </Source>
    <Source id="macro4" label="SHADOW" legacy="0">
      <Route dest="throat_shift" depth="-0.2" bipolar="0"/>
      <Route dest="screw_depth" depth="0.35" bipolar="0"/>
      <Route dest="spectral_crown" depth="-0.25" bipolar="0"/>
      <Route dest="space_damp" depth="0.3" bipolar="0"/>
      <Route dest="master_gain" depth="-0.03" bipolar="0"/>
    </Source>
    <Source id="xy_x">
      <Route dest="v2_tex_mix" depth="0.2" bipolar="1"/>
      <Route dest="breath_amount" depth="-0.1" bipolar="1"/>
      <Route dest="glottal_tension" depth="-0.1" bipolar="1"/>
    </Source>
    <Source id="xy_y">
      <Route dest="spectral_crown" depth="0.25" bipolar="1"/>
      <Route dest="space_shimmer" depth="0.2" bipolar="1"/>
      <Route dest="phoneme_y" depth="0.15" bipolar="1"/>
    </Source>
    <Source id="mod_wheel">
      <Route dest="spectral_crown" depth="0.12" bipolar="0"/>
      <Route dest="vibrato_depth" depth="0.15" bipolar="0"/>
      <Route dest="v2_tex_mix" depth="0.12" bipolar="0"/>
    </Source>
    <Source id="pressure">
      <Route dest="v2_tex_mix" depth="0.15" bipolar="0"/>
      <Route dest="glottal_tension" depth="0.12" bipolar="0"/>
      <Route dest="vibrato_depth" depth="0.12" bipolar="0"/>
    </Source>
    <Source id="breath">
      <Route dest="v2_tex_mix" depth="0.15" bipolar="0"/>
      <Route dest="glottal_tension" depth="0.12" bipolar="0"/>
      <Route dest="vibrato_depth" depth="0.12" bipolar="0"/>
    </Source>
  </V2Control>
</MonolithPreset>
