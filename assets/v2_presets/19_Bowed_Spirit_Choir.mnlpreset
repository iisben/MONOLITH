<?xml version="1.0" encoding="UTF-8"?>
<MonolithPreset version="2" name="Bowed Spirit Choir" author="Monolith Audio" category="Ethereal Hybrids &amp; Evolving Textures" tags="texture,bowed,hybrid,strings,choir,cinematic,xy,alto,flagship,monolith ii" description="Alto choir married to bowed crystal: the bow speaks first, the voices bloom out of it." favorite="0">
  <MacroLabels m1="BOW" m2="SPIRIT" m3="MORPH" m4="DEPTH"/>
  <Params>
    <Param id="phoneme_x" value="0.46"/>
    <Param id="phoneme_y" value="0.74"/>
    <Param id="orbit_enable" value="0"/>
    <Param id="orbit_rate" value="0.18"/>
    <Param id="orbit_depth" value="0.35"/>
    <Param id="orbit_sync" value="0"/>
    <Param id="register_mode" value="2"/>
    <Param id="ensemble_size" value="10"/>
