    <Param id="space_decay" value="0.76"/>
    <Param id="space_damp" value="0.3"/>
    <Param id="space_shimmer" value="0.26"/>
    <Param id="space_freeze" value="0"/>
    <Param id="cc64_freeze" value="0"/>
    <Param id="macro_colossus" value="0"/>
    <Param id="macro_specter" value="0"/>
    <Param id="macro_rot" value="0"/>
    <Param id="macro_abyss" value="0"/>
    <Param id="legato_enable" value="0"/>
    <Param id="glide_time" value="0.14"/>
    <Param id="expression_level" value="0.8"/>
    <Param id="v2_tex_mix" value="0.3"/>
    <Param id="v2_tex_asset" value="7"/>
    <Param id="v2_tex_tune" value="0"/>
    <Param id="v2_tex_keytrack" value="1"/>
    <Param id="v2_tex_attack" value="0.3"/>
    <Param id="v2_tex_release" value="2.5"/>
    <Param id="v2_tex_vel_sens" value="0.6"/>
    <Param id="v2_tex_hp" value="160"/>
    <Param id="v2_tex_lp" value="16000"/>
    <Param id="v2_tex_width" value="1"/>
    <Param id="v2_xy_x" value="0.5"/>
    <Param id="v2_xy_y" value="0.5"/>
    <Param id="v2_xy_mode" value="2"/>
    <Param id="v2_expr_vibrato" value="0.5"/>
    <Param id="v2_expr_effort" value="0.5"/>
    <Param id="v2_expr_openness" value="0.55"/>
    <Param id="v2_expr_swell" value="0.5"/>
  </Params>
  <V2Control>
    <Source id="macro1" label="BOW" legacy="0">
      <Route dest="v2_tex_mix" depth="0.3" bipolar="0"/>
      <Route dest="v2_tex_width" depth="0.15" bipolar="0"/>
      <Route dest="master_gain" depth="-0.04" bipolar="0"/>
    </Source>
    <Source id="macro2" label="SPIRIT" legacy="0">
      <Route dest="breath_amount" depth="0.45" bipolar="0"/>
      <Route dest="spectral_crown" depth="0.4" bipolar="0"/>
      <Route dest="space_shimmer" depth="0.45" bipolar="0"/>
    </Source>
    <Source id="macro3" label="MORPH" legacy="0">
      <Route dest="phoneme_x" depth="0.25" bipolar="0"/>
      <Route dest="phoneme_y" depth="-0.2" bipolar="0"/>
    </Source>
    <Source id="macro4" label="DEPTH" legacy="0">
      <Route dest="space_mix" depth="0.25" bipolar="0"/>
      <Route dest="space_decay" depth="0.18" bipolar="0"/>
      <Route dest="sub_abyss" depth="0.15" bipolar="0"/>
    </Source>
    <Source id="xy_x">
      <Route dest="v2_tex_mix" depth="0.2" bipolar="1"/>
      <Route dest="glottal_tension" depth="-0.1" bipolar="1"/>
    </Source>
    <Source id="xy_y">
      <Route dest="spectral_crown" depth="0.2" bipolar="1"/>
      <Route dest="v2_tex_lp" depth="0.25" bipolar="1"/>
      <Route dest="phoneme_y" depth="0.1" bipolar="1"/>
    </Source>
    <Source id="mod_wheel">
      <Route dest="v2_tex_mix" depth="0.12" bipolar="0"/>
      <Route dest="vibrato_depth" depth="0.15" bipolar="0"/>
      <Route dest="spectral_crown" depth="0.1" bipolar="0"/>
    </Source>
    <Source id="pressure">
      <Route dest="v2_tex_mix" depth="0.15" bipolar="0"/>
      <Route dest="vibrato_depth" depth="0.15" bipolar="0"/>
      <Route dest="glottal_tension" depth="0.1" bipolar="0"/>
    </Source>
    <Source id="breath">
      <Route dest="v2_tex_mix" depth="0.15" bipolar="0"/>
      <Route dest="vibrato_depth" depth="0.15" bipolar="0"/>
      <Route dest="glottal_tension" depth="0.1" bipolar="0"/>
    </Source>
  </V2Control>
</MonolithPreset>
