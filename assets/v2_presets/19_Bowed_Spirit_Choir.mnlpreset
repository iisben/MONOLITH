    <Param id="breath_amount" value="0.2"/>
    <Param id="throat_shift" value="0"/>
    <Param id="formant_focus" value="0.66"/>
    <Param id="sub_abyss" value="0.22"/>
    <Param id="spectral_crown" value="0.38"/>
    <Param id="master_gain" value="-4.5"/>
    <Param id="drive_amount" value="0.1"/>
    <Param id="tape_instability" value="0.08"/>
    <Param id="oxide_damping" value="0.06"/>
    <Param id="screw_pitch" value="0"/>
    <Param id="screw_depth" value="0"/>
